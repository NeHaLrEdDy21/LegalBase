# ── Clerk (dashboard.clerk.com → API Keys) ─────────────────────────────────────
# Without this, the app falls back to local localStorage auth (dev only)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# ── Backend API URL ────────────────────────────────────────────────────────────
# Defaults to http://localhost:8000/api/v1 — override for production
# VITE_API_URL=https://api.yourdomain.com/api/v1
