# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=nim

# ── Google Gemini (fallback) ───────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-preview-04-17
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── NVIDIA NIM — Gemma 4 31B (cloud-hosted, free tier: ngc.nvidia.com) ─────────
NGC_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=google/gemma-4-31b-it
NIM_TEMPERATURE=0.2
NIM_MAX_TOKENS=2048
NIM_ENABLE_THINKING=false

# ── Embeddings ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Vector store / chunking ────────────────────────────────────────────────────
VECTOR_STORE_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CONVERSATION_TURNS=20

# ── API server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:80","http://localhost:5173"]
DEBUG=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
LAWYER_MODE=true

# ── Supabase (dashboard.supabase.com → project → Settings → API) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── Clerk (dashboard.clerk.com → API Keys) ─────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
