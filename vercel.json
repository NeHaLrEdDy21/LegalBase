{
  "buildCommand": "cd frontend && npm ci --frozen-lockfile && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://your-backend-url.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
